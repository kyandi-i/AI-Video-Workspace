# Optional initial root, used only when bootstrap config has no saved selection.
# Default: ~/AI-Video-Workspace. Relative paths resolve against the repository root.
# AVW_WORKSPACE_ROOT=D:/AI-Video-Workspace

# Default on Windows: %APPDATA%/AI-Video-Workspace/config.json
# To isolate another instance/test environment, set both values to independent paths.
# AVW_BOOTSTRAP_CONFIG_PATH=D:/AI-Video-Workspace-Config/config.json
